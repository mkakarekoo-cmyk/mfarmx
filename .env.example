# ═══════════════════════════════════════════════════════════════════════════════
#  M-FarmX — zmienne środowiskowe
#
#  ⚠️ TEN PLIK NIE ZAWIERA SEKRETÓW i nigdy nie może ich zawierać — jest w repozytorium.
#  Prawdziwe wartości wpisuje się w panelu Supabase (Edge Functions → Secrets).
#
#  ⚠️ Zmienne COPERNICUS_* NIE trafiają do frontendu. M-FarmX to statyczny HTML,
#  więc wszystko, co znajdzie się w index.html, jest publiczne. Sekrety żyją wyłącznie
#  w funkcji serwerowej `satelita`.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Copernicus Data Space (zdjęcia Sentinel-2) ────────────────────────────────
# Skąd wziąć: https://dataspace.copernicus.eu → zaloguj się →
#   User Settings → OAuth clients → Create new client
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# Opcjonalne — domyślne wartości są wpisane w funkcji, ustaw tylko gdy Copernicus
# zmieni adresy albo chcesz wskazać inne środowisko.
# COPERNICUS_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
# COPERNICUS_API_BASE_URL=https://sh.dataspace.copernicus.eu

# ── Zakładanie kont pracownikom (funkcja admin-uzytkownicy) ───────────────────
ADMIN_EMAILS=

# ── Podstawiane automatycznie przez Supabase, NIE ustawiaj ręcznie ────────────
# SUPABASE_URL
# SUPABASE_SERVICE_ROLE_KEY
